{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bastioncommand.local/schemas/viper-import-draft-v1.json",
  "title": "Viper Cowork Import Draft",
  "description": "A single batch of proposed Viper updates for ONE existing case, produced by an authorized Claude Cowork Skill. Nothing in this file is written to the Viper database until a human reviewer approves it in Viper's Cowork Import tab.",
  "type": "object",
  "required": ["schema_version", "incident_number", "source", "proposals"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "viper-import-draft-v1"
    },
    "incident_number": {
      "type": "string",
      "pattern": "^INC-\\d+$",
      "description": "Must exactly match an existing Case.incident_number in Viper. Viper rejects missing, non-matching, or ambiguous values - it will never fall back to matching by case name, and will never create a new case."
    },
    "source": {
      "type": "object",
      "required": ["kind", "subject", "sender", "received_at", "reference"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["email"],
          "description": "Only 'email' is supported in the initial pilot. Teams chat analysis is excluded until the review workflow and extraction quality are validated."
        },
        "subject": { "type": "string", "minLength": 1 },
        "sender": { "type": "string", "minLength": 1 },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp, e.g. 2026-09-25T14:30:00Z."
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Outlook message id or export path - enough to re-locate the original source for an auditor, without embedding the full message."
        }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/proposal" }
    }
  },
  "definitions": {
    "proposal": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        { "$ref": "#/definitions/timelineProposal" },
        { "$ref": "#/definitions/communicationLogProposal" },
        { "$ref": "#/definitions/dueOutProposal" }
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "timelineProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timestamp", "description"],
      "properties": {
        "kind": { "const": "timeline" },
        "timestamp": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["detection", "containment", "compromise", "communication", "recovery"],
          "default": "communication"
        },
        "confidence": { "$ref": "#/definitions/confidence" },
        "evidence_excerpt": { "type": "string" }
      }
    },
    "communicationLogProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timestamp", "comm_type", "summary"],
      "properties": {
        "kind": { "const": "communication_log" },
        "timestamp": { "type": "string", "format": "date-time" },
        "comm_type": {
          "type": "string",
          "enum": ["Vendor", "SA Deconfliction", "Final CAN", "CAN", "CCIR", "CTM", "Legal Request"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "evidence_excerpt": { "type": "string" }
      }
    },
    "dueOutProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "task"],
      "properties": {
        "kind": { "const": "due_out" },
        "task": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "priority": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"],
          "default": "Medium"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "In Progress", "Completed"],
          "default": "Pending"
        },
        "due_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "evidence_excerpt": { "type": "string" }
      }
    }
  }
}
